# Copy to .env for `netlify dev`. `npm run dev` needs none of these.
# Ask Ethan for the values: they point at the live spreadsheet and send real
# email. Never commit .env. All of these are server-side only (functions);
# none is VITE_-prefixed, so none reaches the browser.

# Google Sheets (netlify/lib/sheets.ts)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Double-quoted, with the \n sequences kept as written.
GOOGLE_PRIVATE_KEY=

# Contact form email via Resend (netlify/functions/submit-contact.ts)
RESEND_API_KEY=
CONTACT_EMAIL=
# A sender on a Resend-verified domain. Unset, mail only reaches the Resend account owner.
CONTACT_FROM_EMAIL=

# Events source (netlify/functions/get-events.ts). Optional: sheet (default) or supabase.
EVENTS_SOURCE=
# Only needed when EVENTS_SOURCE=supabase (netlify/lib/supabase.ts).
SUPABASE_URL=
SUPABASE_ANON_KEY=
